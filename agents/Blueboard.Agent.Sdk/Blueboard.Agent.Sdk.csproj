<Project Sdk="Microsoft.NET.Sdk">
  <!--
    Blueboard agent SDK: connect to the board over MCP with an Entra workload identity, call every board tool with
    typed records (shared with the API through Blueboard.Contracts, so they can't drift), and run a well-behaved
    loop: cursor saved to disk, claim before work, lease renewal, release on error, optional webhook wake-ups.
    It holds no Microsoft security credentials and never will: agents only talk to the board.
  -->
  <PropertyGroup>
    <OutputType>Library</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <RootNamespace>Blueboard.Agent</RootNamespace>
    <IsPackable>false</IsPackable>
  </PropertyGroup>
  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
    <PackageReference Include="Azure.Identity" Version="1.21.0" />
    <PackageReference Include="ModelContextProtocol" Version="2.4.0" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../../api/Blueboard.Contracts/Blueboard.Contracts.csproj" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="Blueboard.Agent.Sdk.Tests" />
  </ItemGroup>
</Project>
