<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <AssemblyName>blueboard-enrichment-agent</AssemblyName>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Anthropic" Version="13.10.0" />
    <PackageReference Include="Anthropic.Foundry" Version="1.0.0" />
  </ItemGroup>
  <ItemGroup>
    <!-- Board connection, typed tools, cursor/claim loop. Brings Azure.Identity and the MCP client with it. -->
    <ProjectReference Include="../Blueboard.Agent.Sdk/Blueboard.Agent.Sdk.csproj" />
  </ItemGroup>
</Project>
