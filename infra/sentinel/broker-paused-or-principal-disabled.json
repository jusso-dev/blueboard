{
  "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentTemplate.json#",
  "contentVersion": "1.0.0.0",
  "metadata": {
    "description": "blueboard: Sentinel analytics rule (broker-paused-or-principal-disabled). Generated from docs/SECURITY.md detections."
  },
  "parameters": {
    "workspace": {
      "type": "string",
      "metadata": {
        "description": "Log Analytics workspace with Microsoft Sentinel enabled"
      }
    }
  },
  "resources": [
    {
      "type": "Microsoft.OperationalInsights/workspaces/providers/alertRules",
      "apiVersion": "2023-02-01",
      "name": "[concat(parameters('workspace'), '/Microsoft.SecurityInsights/7ff0bc33-b96f-51fe-be02-d2ce4309c034')]",
      "kind": "Scheduled",
      "location": "[resourceGroup().location]",
      "properties": {
        "displayName": "blueboard: broker paused or principal disabled",
        "description": "An admin paused the broker or disabled a principal on the board. Usually incident response for the board itself; confirm it was planned.",
        "severity": "Informational",
        "enabled": true,
        "query": "BlueboardAudit_CL\n| where Event in (\"broker.paused\", \"broker.resumed\", \"principal.disabled\", \"principal.enabled\")\n| project TimeGenerated, Actor, Event, Subject, Reason = tostring(Detail.reason)",
        "queryFrequency": "PT5M",
        "queryPeriod": "PT5M",
        "triggerOperator": "GreaterThan",
        "triggerThreshold": 0,
        "suppressionDuration": "PT1H",
        "suppressionEnabled": false,
        "tactics": [
          "Impact"
        ],
        "techniques": [],
        "incidentConfiguration": {
          "createIncident": false,
          "groupingConfiguration": {
            "enabled": false,
            "reopenClosedIncident": false,
            "lookbackDuration": "PT5H",
            "matchingMethod": "AllEntities",
            "groupByEntities": [],
            "groupByAlertDetails": [],
            "groupByCustomDetails": []
          }
        },
        "eventGroupingSettings": {
          "aggregationKind": "AlertPerResult"
        },
        "entityMappings": [
          {
            "entityType": "Account",
            "fieldMappings": [
              {
                "identifier": "Name",
                "columnName": "Actor"
              }
            ]
          }
        ]
      }
    }
  ]
}
