{
  "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentTemplate.json#",
  "contentVersion": "1.0.0.0",
  "metadata": {
    "description": "blueboard: Sentinel analytics rule (rejected-on-recheck). Fires when an approval attempt was refused because policy or evidence changed since the request was filed."
  },
  "parameters": {
    "workspace": {
      "type": "string",
      "metadata": {
        "description": "Log Analytics workspace with Microsoft Sentinel enabled"
      }
    }
  },
  "resources": [
    {
      "type": "Microsoft.OperationalInsights/workspaces/providers/alertRules",
      "apiVersion": "2023-02-01",
      "name": "[concat(parameters('workspace'), '/Microsoft.SecurityInsights/5e1a9d44-2c87-5b13-9f2a-4d7e1c3a8b90')]",
      "kind": "Scheduled",
      "location": "[resourceGroup().location]",
      "properties": {
        "displayName": "blueboard: approval refused on policy re-check",
        "description": "An approver attempted to approve a brokered action, but re-evaluating the current policy rejected it (for example, the target was added to a protected list or disabled after the request was created).",
        "severity": "Medium",
        "enabled": true,
        "query": "BlueboardAudit_CL\n| where Event == \"action.rejected_on_recheck\"\n| extend Reason = tostring(Detail.reason)\n| project TimeGenerated, Actor, Subject, Reason",
        "queryFrequency": "PT10M",
        "queryPeriod": "PT10M",
        "triggerOperator": "GreaterThan",
        "triggerThreshold": 0,
        "suppressionDuration": "PT1H",
        "suppressionEnabled": false,
        "tactics": [
          "Impact",
          "DefenseEvasion"
        ],
        "techniques": [
          "T1489"
        ],
        "incidentConfiguration": {
          "createIncident": true,
          "groupingConfiguration": {
            "enabled": false,
            "reopenClosedIncident": false,
            "lookbackDuration": "PT5H",
            "matchingMethod": "AllEntities",
            "groupByEntities": [],
            "groupByAlertDetails": [],
            "groupByCustomDetails": []
          }
        },
        "eventGroupingSettings": {
          "aggregationKind": "AlertPerResult"
        },
        "entityMappings": [
          {
            "entityType": "Account",
            "fieldMappings": [
              {
                "identifier": "Name",
                "columnName": "Actor"
              }
            ]
          }
        ]
      }
    }
  ]
}
