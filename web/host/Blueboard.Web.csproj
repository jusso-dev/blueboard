<Project Sdk="Microsoft.NET.Sdk.Web">
  <!--
    Hosts the React build on Azure App Service (Linux, .NET 10) in Australia East.
    Serves web/dist as wwwroot with strict security headers, an SPA fallback, the MSAL redirect bridge
    and /config.json (tenant, client id, API URL) from app settings, so one build runs in every environment.
    It has no identity, no secrets and no access to data: the browser calls the Function App directly
    with an Entra access token.
  -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <InvariantGlobalization>true</InvariantGlobalization>
    <RootNamespace>Blueboard.Web</RootNamespace>
    <AssemblyName>blueboard-web</AssemblyName>
  </PropertyGroup>
  <ItemGroup>
    <!-- The React build (pnpm build in web/) becomes wwwroot. Missing in a fresh checkout: the host still builds. -->
    <Content Include="../dist/**" Link="wwwroot/%(RecursiveDir)%(Filename)%(Extension)" CopyToPublishDirectory="PreserveNewest" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="Blueboard.Api.Tests" />
  </ItemGroup>
</Project>
