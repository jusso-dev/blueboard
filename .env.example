# --- Database ---------------------------------------------------------------
DATABASE_URL=postgres://postgres:devpass@127.0.0.1:55432/blueboard
# In Azure: set PGHOST/PGUSER/PGDATABASE and PG_ENTRA_AUTH=true (managed identity, no password).
# PG_ENTRA_AUTH=true

# --- Auth -------------------------------------------------------------------
# Local only. Lets you pick a seeded principal at /dev-login and lets agents use BOARD_DEV_PRINCIPAL. Refused in production.
DEV_AUTH=true
# Entra: tenant + the board API app registration (agents request tokens for "<audience>/.default").
# AZURE_TENANT_ID=00000000-0000-0000-0000-000000000000
# BOARD_API_AUDIENCE=api://blueboard
# Humans: Container Apps built-in auth (Easy Auth) with Entra in front of the UI.
# EASY_AUTH=true

# --- Defender / Sentinel ------------------------------------------------------
INGEST_ENABLED=false
INGEST_INTERVAL_SECONDS=60
INGEST_LOOKBACK_HOURS=24
# Off = approved actions are recorded as dry runs. Turn on only once policy.json is reviewed.
BROKER_EXECUTE=false
# BLUEBOARD_POLICY_FILE=./policy.json

# --- Reference agent (agents/enrichment) --------------------------------------
BOARD_URL=http://localhost:3417
BOARD_DEV_PRINCIPAL=enrichment-agent
# Claude on Microsoft Foundry (default). Entra auth via DefaultAzureCredential unless an API key is set.
ANTHROPIC_FOUNDRY_RESOURCE=your-foundry-resource
# ANTHROPIC_FOUNDRY_API_KEY=
CLAUDE_MODEL=claude-opus-5-5
# Client-side refusal fallback (must also be deployed in Foundry). Empty string disables.
CLAUDE_FALLBACK_MODEL=claude-opus-4-8
# For local dev against the first-party API instead: CLAUDE_PROVIDER=anthropic + ANTHROPIC_API_KEY
AGENT_EFFORT=high
AGENT_POLL_SECONDS=15
