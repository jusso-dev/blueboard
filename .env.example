# Local development. The API reads these from api/Blueboard.Api/local.settings.json
# (copy local.settings.example.json); the agent reads them from the environment.

# --- API (Azure Functions, C#) -----------------------------------------------
DATABASE_URL=postgres://postgres:devpass@127.0.0.1:55432/blueboard
# Local only: accept "Bearer dev:<handle>" and x-dev-principal. Refused when running in Azure.
DEV_AUTH=true
INGEST_ENABLED=false
# Off = approved actions are recorded as dry runs.
BROKER_EXECUTE=false
# Entra (in Azure these come from Bicep): tenant + board API app registration.
# AZURE_TENANT_ID=
# BOARD_API_AUDIENCE=api://blueboard-dev
# BOARD_API_CLIENT_ID=

# --- Reference agent (agents/Blueboard.EnrichmentAgent) ----------------------
BOARD_URL=http://localhost:7351
BOARD_DEV_PRINCIPAL=enrichment-agent
# Claude on Microsoft Foundry (default; Entra auth via DefaultAzureCredential).
ANTHROPIC_FOUNDRY_RESOURCE=your-foundry-resource
CLAUDE_MODEL=claude-opus-5-5
# Client-side refusal fallback (must also be deployed in Foundry). Empty disables.
CLAUDE_FALLBACK_MODEL=claude-opus-4-8
# For local dev against the first-party API instead: CLAUDE_PROVIDER=anthropic + ANTHROPIC_API_KEY
AGENT_EFFORT=high
AGENT_POLL_SECONDS=15
