n every route)&lt;br&gt;&lt;b&gt;MCP&lt;/b&gt; /runtime/webhooks/mcp: 14 tools, Entra bearer per call&lt;br&gt;&lt;b&gt;Action broker&lt;/b&gt;: policy → human approval → execute&lt;br&gt;&lt;b&gt;Enrichment&lt;/b&gt;: advanced hunting + entity lookups (read-only)&lt;br&gt;&lt;b&gt;Timers&lt;/b&gt;: incident poller (1 min) · stuck-action recovery&lt;br&gt;built-in auth on: strips forged principal headers&lt;br&gt;migrations applied at start-up · identity: blueboard-id-api&lt;/font&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#0078D4;fontSize=12;fontColor=#1F2937;align=left;verticalAlign=top;spacingLeft=60;spacingRight=10;spacingTop=12;" vertex="1" parent="1"><mxGeometry x="320" y="470" width="520" height="230" as="geometry"/></mxCell><mxCell id="c23" value="" style="shape=image;html=1;aspect=fixed;imageAspect=0;image=data:image/svg+xml,;" vertex="1" parent="1"><mxGeometry x="332" y="482" width="36" height="36" as="geometry"/></mxCell><mxCell id="c24" value="&lt;b&gt;Storage account&lt;/b&gt;&lt;br&gt;&lt;font style=&#x27;font-size:10px&#x27; color=&#x27;#4B5563&#x27;&gt;Functions host + deployment package&lt;br&gt;shared keys disabled · identity only&lt;/font&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#C7CED9;fontSize=12;fontColor=#1F2937;align=left;verticalAlign=middle;spacingLeft=60;spacingRight=10;" vertex="1" parent="1"><mxGeometry x="320" y="780" width="250" height="84" as="geometry"/></mxCell><mxCell id="c25" value="" style="shape=image;html=1;aspect=fixed;imageAspect=0;image=data:image/svg+xml,;" vertex="1" parent="1"><mxGeometry x="332" y="804.0" width="36" height="36" as="geometry"/></mxCell><mxCell id="c26" value="&lt;b&gt;Application Insights&lt;/b&gt;&lt;br&gt;&lt;font style=&#x27;font-size:10px&#x27; color=&#x27;#4B5563&#x27;&gt;Entra auth only (no ingestion key)&lt;br&gt;→ Log Analytics workspace&lt;/font&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#F