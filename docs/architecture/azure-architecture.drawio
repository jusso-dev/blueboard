<mxfile host="blueboard" type="device"><diagram id="azure" name="blueboard on Azure"><mxGraphModel dx="1800" dy="1200" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1800" pageHeight="1200" background="#FFFFFF" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c3" value="&lt;b style=&#x27;font-size:20px&#x27;&gt;blueboard on Azure (Australia East)&lt;/b&gt;&lt;br&gt;React front end on App Service · C# Azure Functions back end · Microsoft Defender XDR + Microsoft Sentinel" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;fontColor=#1F2937;" vertex="1" parent="1"><mxGeometry x="30" y="18" width="1300" height="50" as="geometry"/></mxCell><mxCell id="c4" value="Microsoft Entra ID (tenant)" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;fillColor=#F7F3FE;strokeColor=#7C3AED;strokeWidth=1.5;dashed=1;dashPattern=6 4;verticalAlign=top;align=left;spacingLeft=12;spacingTop=8;fontStyle=1;fontSize=13;fontColor=#1F2937;container=0;" vertex="1" parent="1"><mxGeometry x="290" y="88" width="1480" height="140" as="geometry"/></mxCell><mxCell id="c5" value="&lt;b&gt;App registration · blueboard-&amp;lt;env&amp;gt;&lt;/b&gt;&lt;br&gt;&lt;font style=&#x27;font-size:10px&#x27; color=&#x27;#4B5563&#x27;&gt;API: api://blueboard-&amp;lt;env&amp;gt; · 5 app roles · scope Board.Access&lt;br&gt;single-page app: /redirect, auth code + PKCE&lt;br&gt;no client secret, no implicit flow&lt;/font&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#C7CED9;fontSize=12;fontColor=#1F2937;align=left;verticalAlign=middle;spacingLeft=60;spacingRight=10;" vertex="1" parent="1"><mxGeometry x="310" y="122" width="450" height="88" as="geometry"/></mxCell><mxCell id="c6" value="" style="shape=image;html=1;aspect=fixed;imageAspect=0;image=data:image/svg+xml,;" vertex="1" parent="1"><mxGeometry x="322" y="148.0" width="36" height="36" as="geometry"/></mxCell><mxCell id="c7" value="&lt;b&gt;Enterprise application&lt;/b&gt;&lt;br&gt;&lt;font style=&#x27;font-size:10px&#x27; color=&#x27;#4B5563&#x27;&gt;assignment required: only assigned users,&lt;br&gt;groups and agents can get a token&lt;/font&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#C7CED9;fontSize=12;fontColor=#1F2937;align=left;verticalAlign=middle;spacingLeft=60;spacingRight=10;" vertex="1" parent="1"><mxGeometry x="780" y="122" width="450" height="88" as="geometry"/></mxCell><mxCell id="c8" value="" style="shape=image;html=1;aspect=fixed;imageAspect=0;image=data:image/svg+xml,;" vertex="1" parent="1"><mxGeometry x="792" y="148.0" width="36" height="36" as="geometry"/></mxCell><mxCell id="c9" value="&lt;b&gt;Managed identity · blueboard-id-api&lt;/b&gt;&lt;br&gt;&lt;font style=&#x27;font-size:10px&#x27; color=&#x27;#4B5563&#x27;&gt;Graph + Defender application permissions&lt;br&gt;PostgreSQL Entra admin · storage data roles&lt;/font&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#C7CED9;fontSize=12;fontColor=#1F2937;align=left;verticalAlign=middle;spacingLeft=60;spacingRight=10;" vertex="1" parent="1"><mxGeometry x="1250" y="122" width="500" height="88" as="geometry"/></mxCell><mxCell id="c10" value="" style="shape=image;html=1;aspect=fixed;imageAspect=0;image=data:image/svg+xml,;" vertex="1" parent="1"><mxGeometry x="1262" y="148.0" width="36" height="36" as="geometry"/></mxCell><mxCell id="c11" value="Users and agents" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;fillColor=#F9FAFB;strokeColor=#9CA3AF;strokeWidth=1.5;dashed=1;dashPattern=6 4;verticalAlign=top;align=left;spacingLeft=12;spacingTop=8;fontStyle=1;fontSize=13;fontColor=#1F2937;container=0;" vertex="1" parent="1"><mxGeometry x="30" y="270" width="200" height="470" as="geometry"/></mxCell><mxCell id="c12" value="&lt;b&gt;SOC analysts&lt;/b&gt;&lt;br&gt;&lt;font style=&#x27;font-size:10px&#x27; color=&#x27;#4B5563&#x27;&gt;browser · MSAL sign-in&lt;br&gt;Board.* app roles&lt;/font&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#C7CED9;fontSize=12;fontColor=#1F2937;align=left;verticalAlign=middle;spacingLeft=60;spacingRight=10;" vertex="1" parent="1"><mxGeometry x="42" y="345" width="176" height="90" as="geometry"/></mxCell><mxCell id="c13" value="" style="shape=image;html=1;aspect=fixed;imageAspect=0;image=data:image/svg+xml,;" vertex="1" parent="1"><mxGeometry x="54" y="372.0" width="36" height="36" as="geometry"/></mxCell><mxCell id="c14" value="&lt;b&gt;External agents&lt;/b&gt;&lt;br&gt;&lt;font style=&#x27;font-size:10px&#x27; color=&#x27;#4B5563&#x27;&gt;any MCP client&lt;br&gt;app-only Entra token&lt;br&gt;never Board.Approve&lt;/font&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#C7CED9;fontSize=12;fontColor=#1F2937;align=left;verticalAlign=middle;spacingLeft=14;spacingRight=10;" vertex="1" parent="1"><mxGeometry x="42" y="495" width="176" height="80" as="geometry"/></mxCell><mxCell id="c15" value="&lt;b&gt;Reference agent&lt;/b&gt;&lt;br&gt;&lt;font style=&#x27;font-size:10px&#x27; color=&#x27;#4B5563&#x27;&gt;C# · Anthropic SDK&lt;br&gt;Claude on Foundry&lt;br&gt;runs anywhere with an&lt;br&gt;Entra workload identity&lt;/font&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#C7CED9;fontSize=12;fontColor=#1F2937;align=left;verticalAlign=middle;spacingLeft=14;spacingRight=10;" vertex="1" parent="1"><mxGeometry x="42" y="615" width="176" height="100" as="geometry"/></mxCell><mxCell id="c16" value="Azure resource group · Australia East (every resource in one region)" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;fillColor=#F3F8FD;strokeColor=#0078D4;strokeWidth=1.5;dashed=1;dashPattern=6 4;verticalAlign=top;align=left;spacingLeft=34;spacingTop=8;fontStyle=1;fontSize=13;fontColor=#1F2937;container=0;" vertex="1" parent="1"><mxGeometry x="290" y="252" width=