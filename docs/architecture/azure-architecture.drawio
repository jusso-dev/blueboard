Size=12;fontColor=#0F172A;align=left;verticalAlign=middle;spacingLeft=58;spacingRight=10;" vertex="1" parent="1"><mxGeometry x="798" y="864" width="380" height="94" as="geometry"/></mxCell><mxCell id="c38" value="" style="shape=image;html=1;aspect=fixed;imageAspect=0;image=data:image/svg+xml,;" vertex="1" parent="1"><mxGeometry x="810" y="893.0" width="36" height="36" as="geometry"/></mxCell><mxCell id="c39" value="&lt;b&gt;Observability &amp;amp; Tamper-Evident Audit Export&lt;/b&gt; &lt;font style=&#x27;font-size:10px&#x27; color=&#x27;#475569&#x27;&gt;— All logs &amp;amp; audit streams stay in Australia&lt;/font&gt;" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#64748B;strokeWidth=1.5;verticalAlign=top;align=left;spacingLeft=14;spacingTop=9;fontSize=13;fontColor=#0F172A;container=0;" vertex="1" parent="1"><mxGeometry x="384" y="994" width="812" height="230" as="geometry"/></mxCell><mxCell id="c40" value="&lt;b&gt;Application Insights&lt;/b&gt;&lt;br&gt;&lt;font style=&#x27;font-size:10px&#x27; color=&#x27;#475569&#x27;&gt;Workspace-based telemetry&lt;br&gt;Local auth disabled (Entra only)&lt;br&gt;Monitoring Metrics Publisher&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#CBD5E1;strokeWidth=1.2;fontSize=12;fontColor=#0F172A;align=left;verticalAlign=middle;spacingLeft=58;spacingRight=10;" vertex="1" parent="1"><mxGeometry x="402" y="1034" width="246" height="94" as="geometry"/></mxCell><mxCell id="c41" value="" style="shape=image;html=1;aspect=fixed;imageAspect=0;image=data:image/svg+xml,;" vertex="1" parent="1"><mxGeometry x="414" y="1063.0" width="36" height="36" as="geometry"/></mxCell><mxCell id="c42" value="&lt;b&gt;Data Collection Rule&lt;/b&gt;&lt;br&gt;&lt;font style=&#x27;font-size:10px&#x27; color=&#x27;#475569&#x27;&gt;DCE + Logs Ingestion (1-min)&lt;br&gt;Stream: Custom-BlueboardAudit_CL&lt;br&gt;High-water mark (no skip/dup)&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#7C3AED;strokeWidth=1.2;fontSize=12;fontColor=#0F172A;align=left;verticalAlign=middle;spacingLeft=58;spacingRight=10;" vertex="1" parent="1"><mxGeometry x="666" y="1034" width="250" height="94" as="geometry"/></mxCell><mxCell id="c43" value="" style="shape=image;html=1;aspect=fixed;imageAspect=0;image=data:image/svg+xml,;" vertex="1" parent="1"><mxGeometry x="678" y="1063.0" width="36" height="36" as="geometry"/></mxCell><mxCell id="c44" value="&lt;b&gt;Log Analytics Workspace&lt;/b&gt;&lt;br&gt;&lt;font style=&#x27;font-size:10px&#x27; color=&#x27;#475569&#x27;&gt;90-day operational telemetry&lt;br&gt;BlueboardAudit_CL (365-day)&lt;br&gt;Feeds Microsoft Sentinel rules&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#CBD5E1;strokeWidth=1.2;fontSize=12;fontColor=#0F172A;align=left;verticalAlign=middle;spacingLeft=58;spacingRight=10;" vertex="1" parent="1"><mxGeometry x="934" y="1034" width="244" height="94" as="geometry"/></mxCell><mxCell id="c45" value="" style="shape=image;html=1;aspect=fixed;imageAspect=0;image=data:image/svg+xml,;" vertex="1" parent="1"><mxGeometry x="946" y="1063.0" width="36" height="36" as="geometry"/></mxCell><mxCell id="c46" value="Optional outbound sinks: Teams Workflows / HTTPS HMAC webhook / Graph Mail.Send (scoped via Exchange Application Access Policy)&lt;br&gt;and token-free external TI feeds (pwn.watch, CISA KEV, FIRST EPSS, NVD, OSV via exact-host TiFetcher)." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=10.0;fontColor=#475569;" vertex="1" parent="1"><mxGeometry x="402" y="1172" width="776" height="38" as="geometry"/></mxCell><mxCell id="c47" value="&lt;b&gt;Microsoft Security Services (Tenant Plane)&lt;/b&gt; &lt;font style=&#x27;font-size:10px&#x27; color=&#x27;#475569&#x27;&gt;— Origin-locked token guard in MsClient.BuildUri&lt;/font&gt;" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;fillColor=#F8FAFC;strokeColor=#64748B;strokeWidth=1.5;dashed=1;dashPattern=6 4;verticalAlign=top;align=left;spacingLeft=14;spacingTop=9;fontSize=13;fontColor=#0F172A;container=0;" vertex="1" parent="1"><mxGeometry x="1290" y="236" width="640" height="566" as="geometry"/></mxCell><mxCell id="c48" value="&lt;b&gt;Microsoft Graph Security &amp;amp; Purview&lt;/b&gt;&lt;br&gt;&lt;font style=&#x27;font-size:10px&#x27; color=&#x27;#475569&#x27;&gt;incidents · alerts_v2 · runHuntingQuery&lt;br&gt;Purview Labels / processContent · Entra&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#0F766E;strokeWidth=1.2;fontSize=12;fontColor=#0F172A;align=left;verticalAlign=middle;spacingLeft=14;spacingRight=10;" vertex="1" parent="1"><mxGeometry x="1308" y="282" width="290" height="86" as="geometry"/></mxCell><mxCell id="c49" value="&lt;b&gt;Defender XDR &amp;amp; Microsoft Purview&lt;/b&gt;&lt;br&gt;&lt;font style=&#x27;font-size:10px&#x27; color=&#x27;#475569&#x27;&gt;Unified SOC · MDE/MDO/MDI · Purview&lt;br&gt;DLP · Insider Risk · Sensitivity Labels&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#94A3B8;strokeWidth=1.2;fontSize=12;fontColor=#0F172A;align=left;verticalAlign=middle;spacingLeft=14;spacingRight=10;" vertex="1" parent="1"><mxGeometry x="1622" y="282" width="290" height="86" as="geometry"/></mxCell><mxCell id="c50" value="&lt;b&gt;Microsoft Defender for Endpoint API&lt;/b&gt;&lt;br&gt;&lt;font style=&#x27;font-size:10px&#x27; color=&#x27;#475569&#x27;&gt;api.security.microsoft.com&lt;br&gt;Isolate, scan, forensics, restrict, IOCs&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#B91C1C;strokeWidth=1.2;fontSize=12;fontColor=#0F172A;align=left;verticalAlign=middle;spacingLeft=14;spacingRight=10;" vertex="1" parent="1"><mxGeometry x="1308" y="392" width="290" height="86" as="geometry"/></mxCell><mxCell id="c51" value="&lt;b&gt;Microsoft Defender for Cloud&lt;/b&gt;&lt;br&gt;&lt;font style=&#x27;font-size:10px&#x27; color=&#x27;#475569&#x27;&gt;Azure RBAC &amp;amp; Key Vault alerts&lt;br&gt;Unified into Defender XDR / Sentinel&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#94A3B8;strokeWidth=1.2;fontSize=12;fontColor=#0F172A;align=left;verticalAlign=middle;spacingLeft=58;spacingRight=10;" vertex="1" parent="1"><mxGeometry x="1622" y="392" width="290" height="86" as="geometry"/></mxCell><mxCell id="c52" value="" style="shape=image;html=1;aspect=fixed;imageAspect=0;image=data:image/svg+xml,;" vertex="1" parent="1"><mxGeometry x="1634" y="417.0" width="36" height="36" as="geometry"/></mxCell><mxCell id="c53" value="&lt;b&gt;Microsoft Sentinel + Sentinel MCP&lt;/b&gt;&lt;br&gt;&lt;font style=&#x27;font-size:10px&#x27; color=&#x27;#475569&#x27;&gt;api.loganalytics.io (run_sentinel_query) · Sentinel MCP (/triage, /graph, /data-exploration)&lt;br&gt;STIX 2.1 TI upload · BlueboardAudit_CL · 9 scheduled board-integrity rules&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#0078D4;strokeWidth=1.2;fontSize=12;fontColor=#0F172A;align=left;verticalAlign=middle;spacingLeft=58;spacingRight=10;" vertex="1" parent="1"><mxGeometry x="1308" y="504" width="604" height="96" as="geometry"/></mxCell><mxCell id="c54" value="" style="shape=image;html=1;aspect=fixed;imageAspect=0;image=data:image/svg+xml,;" vertex="1" parent="1"><mxGeometry x="1320" y="534.0" width="36" height="36" as="geometry"/></mxCell><mxCell id="c55" value="&lt;b&gt;Sentinel Automation Rule (Azure Logic App)&lt;/b&gt;&lt;br&gt;&lt;font style=&#x27;font-size:10px&#x27; color=&#x27;#475569&#x27;&gt;Real-time trigger on Incident Created / Updated → POST /api/incidents/{id}/sync&lt;br&gt;Authenticates with System Managed Identity (Board.Post) · Graph fetch stays server-side&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#7C3AED;strokeWidth=1.2;fontSize=12;fontColor=#0F172A;align=left;verticalAlign=middle;spacingLeft=58;spacingRight=10;" vertex="1" parent="1"><mxGeometry x="1308" y="626" width="604" height="88" as="geometry"/></mxCell><mxCell id="c56" value="" style="shape=image;html=1;aspect=fixed;imageAspect=0;image=data:image/svg+xml,;" vertex="1" parent="1"><mxGeometry x="1320" y="652.0" width="36" height="36" as="geometry"/></mxCell><mxCell id="c57" value="Write permissions are opt-in per action via infra/grant-permissions.sh (ACTIONS=...).&lt;br&gt;Default deploy is READ_ONLY=1 + BROKER_EXECUTE=false. Connector: templates/sentinel/automation-rule-logic-app.json." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=10.0;fontColor=#475569;" vertex="1" parent="1"><mxGeometry x="1308" y="734" width="604" height="38" as="geometry"/></mxCell><mxCell id="c58" value="&lt;b&gt;Microsoft Foundry (Agent LLM Plane)&lt;/b&gt; &lt;font style=&#x27;font-size:10px&#x27; color=&#x27;#475569&#x27;&gt;— Only agent prompts go here; blueboard never calls an LLM&lt;/font&gt;" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;fillColor=#F8FAFC;strokeColor=#64748B;strokeWidth=1.5;dashed=1;dashPattern=6 4;verticalAlign=top;align=left;spacingLeft=14;spacingTop=9;fontSize=13;fontColor=#0F172A;container=0;" vertex="1" parent="1"><mxGeometry x="1290" y="822" width="640" height="128" as="geometry"/></mxCell><mxCell id="c59" value="&lt;b&gt;Microsoft Foundry&lt;/b&gt;&lt;br&gt;&lt;font style=&#x27;font-size:10px&#x27; color=&#x27;#475569&#x27;&gt;Claude Opus 5.5 + fallback model · Entra auth (Cognitive Services User)&lt;br&gt;Swap for any Australian-hosted model if prompts must remain in-country&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#94A3B8;strokeWidth=1.2;fontSize=12;fontColor=#0F172A;align=left;verticalAlign=middle;spacingLeft=58;spacingRight=10;" vertex="1" parent="1"><mxGeometry x="1308" y="860" width="604" height="74" as="geometry"/></mxCell><mxCell id="c60" value="" style="shape=image;html=1;aspect=fixed;imageAspect=0;image=data:image/svg+xml,;" vertex="1" parent="1"><mxGeometry x="1320" y="879.0" width="36" height="36" as="geometry"/></mxCell><mxCell id="c61" value="&lt;b&gt;Data &amp;amp; Control Flows&lt;/b&gt;" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#CBD5E1;strokeWidth=1.5;verticalAlign=top;align=left;spacingLeft=14;spacingTop=9;fontSize=13;fontColor=#0F172A;container=0;" vertex="1" parent="1"><mxGeometry x="1290" y="968" width="640" height="274" as="geometry"/></mxCell><mxCell id="c62" value="&lt;font color=&#x27;#0078D4&#x27;&gt;&lt;b&gt;1&lt;/b&gt;&lt;/font&gt; &lt;b&gt;Analysts → Web App:&lt;/b&gt; HTTPS static React SPA + /config.json (no identity or secrets)&lt;br&gt;&lt;font color=&#x27;#0078D4&#x27;&gt;&lt;b&gt;2&lt;/b&gt;&lt;/font&gt; &lt;b&gt;Analysts → Function App:&lt;/b&gt; HTTPS /api/* with delegated Entra JWT (scope Board.Access)&lt;br&gt;&lt;font color=&#x27;#0078D4&#x27;&gt;&lt;b&gt;3&lt;/b&gt;&lt;/font&gt; &lt;b&gt;Agents ↔ MCP &amp;amp; Webhooks:&lt;/b&gt; /runtime/webhooks/mcp (Entra/Agent ID JWT, 31 tools) + HMAC wake-ups&lt;br&gt;&lt;font color=&#x27;#0369A1&#x27;&gt;&lt;b&gt;4&lt;/b&gt;&lt;/font&gt; &lt;b&gt;Private Data &amp;amp; Vault:&lt;/b&gt; VNet + Private Endpoints → Postgres (Entra), Key Vault &amp;amp; Storage&lt;br&gt;&lt;font color=&#x27;#0F766E&#x27;&gt;&lt;b&gt;5&lt;/b&gt;&lt;/font&gt; &lt;b&gt;Read-Only Ingest &amp;amp; Hunts:&lt;/b&gt; Graph incidents, Purview DLP/IRM/Labels, MDE &amp;amp; Sentinel KQL&lt;br&gt;&lt;font color=&#x27;#B91C1C&#x27;&gt;&lt;b&gt;6&lt;/b&gt;&lt;/font&gt; &lt;b&gt;Brokered Containment:&lt;/b&gt; 21 Defender/Entra/Sentinel writes ONLY after policy + human approval&lt;br&gt;&lt;font color=&#x27;#7C3AED&#x27;&gt;&lt;b&gt;7&lt;/b&gt;&lt;/font&gt; &lt;b&gt;Audit Export → Sentinel:&lt;/b&gt; 1-min DCE/DCR export to BlueboardAudit_CL + 9 analytics rules&lt;br&gt;&lt;font color=&#x27;#7C3AED&#x27;&gt;&lt;b&gt;8&lt;/b&gt;&lt;/font&gt; &lt;b&gt;Sentinel Real-Time Sync:&lt;/b&gt; Automation Rule Logic App triggers POST /api/incidents/{id}/sync&lt;br&gt;&lt;font color=&#x27;#0F172A&#x27;&gt;&lt;b&gt;9&lt;/b&gt;&lt;/font&gt; &lt;b&gt;Reference Agent → Foundry:&lt;/b&gt; Entra-authenticated Messages API (prompts only)&lt;br&gt;&lt;br&gt;&lt;b&gt;Security invariant: agents hold zero Microsoft security permissions; no component stores secrets.&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=10.5;fontColor=#0F172A;" vertex="1" parent="1"><mxGeometry x="1302" y="1000" width="616" height="236" as="geometry"/></mxCell><mxCell id="c63" value="1" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#0078D4;strokeWidth=1.8;fontSize=11;fontStyle=1;fontColor=#0078D4;labelBackgroundColor=#FFFFFF;labelBorderColor=none;exitX=1;exitY=0.35;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="c14" target="c23"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="332" y="323"/><mxPoint x="332" y="328"/></Array></mxGeometry></mxCell><mxCell id="c64" value="2" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#0078D4;strokeWidth=1.8;fontSize=11;fontStyle=1;fontColor=#0078D4;labelBackgroundColor=#FFFFFF;labelBorderColor=none;exitX=1;exitY=0.78;exitDx=0;exitDy=0;entryX=0;entryY=0.16;entryDx=0;entryDy=0;" edge="1" parent="1" source="c14" target="c25"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="342" y="372"/><mxPoint x="342" y="440"/></Array></mxGeometry></mxCell><mxCell id="c65" value="3" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#0078D4;strokeWidth=1.8;fontSize=11;fontStyle=1;fontColor=#0078D4;labelBackgroundColor=#FFFFFF;labelBorderColor=none;startArrow=block;startFill=1;exitX=1;exitY=0.42;exitDx=0;exitDy=0;entryX=0;entryY=0.46;entryDx=0;entryDy=0;" edge="1" parent="1" source="c16" target="c25"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c66" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#0078D4;strokeWidth=1.8;fontSize=11;fontStyle=1;fontColor=#0078D4;labelBackgroundColor=#FFFFFF;labelBorderColor=none;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.72;entryDx=0;entryDy=0;" edge="1" parent="1" source="c18" target="c25"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="336" y="679"/><mxPoint x="336" y="544"/></Array></mxGeometry></mxCell><mxCell id="c67" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#0078D4;strokeWidth=1.8;fontSize=11;fontStyle=1;fontColor=#0078D4;labelBackgroundColor=#FFFFFF;labelBorderColor=none;exitX=1;exitY=0.35;exitDx=0;exitDy=0;entryX=0;entryY=0.88;entryDx=0;entryDy=0;" edge="1" parent="1" source="c19" target="c25"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="348" y="823"/><mxPoint x="348" y="574"/></Array></mxGeometry></mxCell><mxCell id="c68" value="4" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#0369A1;strokeWidth=1.8;fontSize=11;fontStyle=1;fontColor=#0369A1;labelBackgroundColor=#FFFFFF;labelBorderColor=none;exitX=0.68;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="c25" target="c31"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="936" y="610"/><mxPoint x="916" y="610"/></Array></mxGeometry></mxCell><mxCell id="c69" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#0369A1;strokeWidth=1.8;fontSize=11;fontStyle=1;fontColor=#0369A1;labelBackgroundColor=#FFFFFF;labelBorderColor=none;dashed=1;exitX=0.17;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="c25" target="c29"><mxGeometry relative="1" as="geom