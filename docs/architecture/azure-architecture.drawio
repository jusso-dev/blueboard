5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="c37" target="c38"><mxGeometry x="0.0" relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c53" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#6B7280;strokeWidth=1.5;fontSize=12;fontStyle=1;fontColor=#6B7280;labelBackgroundColor=#FFFFFF;labelBorderColor=none;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="c36" target="c38"><mxGeometry x="0.0" relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c54" value="Flows" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#D1D5DB;strokeWidth=1.5;verticalAlign=top;align=left;spacingLeft=12;spacingTop=8;fontStyle=1;fontSize=12;fontColor=#1F2937;container=0;" vertex="1" parent="1"><mxGeometry x="1200" y="800" width="570" height="242" as="geometry"/></mxCell><mxCell id="c55" value="&lt;font color=&#x27;#0078D4&#x27;&gt;&lt;b&gt;1&lt;/b&gt;&lt;/font&gt;&amp;nbsp; Analysts → board: HTTPS, Entra sign-in (built-in auth)&lt;br&gt;&lt;font color=&#x27;#0078D4&#x27;&gt;&lt;b&gt;2&lt;/b&gt;&lt;/font&gt;&amp;nbsp; External agents → MCP /api/mcp with an Entra bearer token&lt;br&gt;&lt;font color=&#x27;#0078D4&#x27;&gt;&lt;b&gt;3&lt;/b&gt;&lt;/font&gt;&amp;nbsp; Reference agent → MCP with its managed-identity token&lt;br&gt;&lt;b&gt;4&lt;/b&gt;&amp;nbsp; Board → PostgreSQL: TLS, Entra token as the password&lt;br&gt;&lt;font color=&#x27;#0F766E&#x27;&gt;&lt;b&gt;5&lt;/b&gt;&lt;/font&gt;&amp;nbsp; Read: incident poller, advanced hunting, entity lookups&lt;br&gt;&lt;font color=&#x27;#B91C1C&#x27;&gt;&lt;b&gt;6&lt;/b&gt;&lt;/font&gt;&amp;nbsp; Write: containment only after policy + human approval&lt;br&gt;&lt;b&gt;7&lt;/b&gt;&amp;nbsp; Agent → Foundry Messages API with an Entra token&lt;br&gt;&lt;font color=&#x27;#4B5563&#x27;&gt;┅&lt;/font&gt;&amp;nbsp; migrations job → PostgreSQL. Container logs stream to Log Analytics;&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;all three containers pull from the registry with their managed identity.&lt;br&gt;&lt;br&gt;Agents hold &lt;b&gt;no&lt;/b&gt; Microsoft security permissions, and no hop uses a secret." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;fontColor=#1F2937;" vertex="1" parent="1"><mxGeometry x="1215" y="830" width="545" height="205" as="geometry"/></mxCell><mxCell id="c56" value="Azure icons © Microsoft, used unmodified under the Azure architecture icon terms. Microsoft Graph, Defender XDR and the Defender for Endpoint API have no Azure architecture icon, so they are drawn as plain cards." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=9;fontColor=#4B5563;" vertex="1" parent="1"><mxGeometry x="30" y="1062" width="1100" height="30" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>