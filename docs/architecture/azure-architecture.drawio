okeColor=#0078D4;strokeWidth=1.2;fontSize=12;fontColor=#0F172A;align=left;verticalAlign=middle;spacingLeft=58;spacingRight=10;" vertex="1" parent="1"><mxGeometry x="46" y="780" width="258" height="122" as="geometry"/></mxCell><mxCell id="c20" value="" style="shape=image;html=1;aspect=fixed;imageAspect=0;image=data:image/svg+xml,;" vertex="1" parent="1"><mxGeometry x="58" y="823.0" width="36" height="36" as="geometry"/></mxCell><mxCell id="c21" value="&lt;b&gt;Azure Resource Group · Australia East (or Australia Southeast)&lt;/b&gt; &lt;font style=&#x27;font-size:10px&#x27; color=&#x27;#475569&#x27;&gt;— Data residency enforced in infra/main.bicep&lt;/font&gt;" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;fillColor=#F0F7FF;strokeColor=#0078D4;strokeWidth=1.5;dashed=1;dashPattern=6 4;verticalAlign=top;align=left;spacingLeft=38;spacingTop=9;fontSize=13;fontColor=#0F172A;container=0;" vertex="1" parent="1"><mxGeometry x="360" y="236" width="860" height="1006" as="geometry"/></mxCell><mxCell id="c22" value="" style="shape=image;html=1;aspect=fixed;imageAspect=0;image=data:image/svg+xml,;" vertex="1" parent="1"><mxGeometry x="372" y="245" width="20" height="20" as="geometry"/></mxCell><mxCell id="c23" value="&lt;b&gt;App Service Web App · blueboard-web&lt;/b&gt;&lt;br&gt;&lt;font style=&#x27;font-size:10px&#x27; color=&#x27;#475569&#x27;&gt;Linux .NET 10 host + React 19 SPA (B1 in mvp · P0v3 in production)&lt;br&gt;Strict CSP · HSTS · X-Frame-Options · /config.json (public values only)&lt;br&gt;Zero managed identity · zero secrets · zero direct database access&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#0078D4;strokeWidth=1.2;fontSize=12;fontColor=#0F172A;align=left;verticalAlign=middle;spacingLeft=58;spacingRight=10;" vertex="1" parent="1"><mxGeometry x="384" y="282" width="812" height="92" as="geometry"/></mxCell><mxCell id="c24" value="" style="shape=image;html=1;aspect=fixed;imageAspect=0;image=data:image/svg+xml,