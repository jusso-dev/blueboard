<Project Sdk="Microsoft.NET.Sdk.Web">
  <!--
    Mock Microsoft Graph + Defender for Endpoint API for the local demo (docker-compose.demo.yml).
    Answers the exact paths the board calls from fixtures in dev/fixtures. Refuses to start unless DEMO_MODE=true,
    and in Azure. It never calls Microsoft and holds no credentials.
  -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <InvariantGlobalization>true</InvariantGlobalization>
    <AssemblyName>blueboard-mock-msapi</AssemblyName>
  </PropertyGroup>
</Project>
